    padding: 28px;
}

.content-poster {
    height: 100%;
    min-height: 165px;
    border: 1px solid rgba(255,255,255,.35);
    padding: 22px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.content-poster span {
    font-size: 9px;
    letter-spacing: 2px;
}

.content-poster strong {
    font-family: "Space Grotesk", sans-serif;
    font-size: 38px;
    line-height: .8;
}

.design-visual {
    background: #13162e;
}

.design-shape {
    position: absolute;
    border-radius: 50%;
    filter: blur(1px);
}

.shape-a {
    width: 190px;
    height: 190px;
    background: linear-gradient(135deg, #6d56ff, #b67cff);
    left: -20px;
    top: 30px;
}

.shape-b {
    width: 140px;
    height: 140px;
    background: linear-gradient(135deg, #47b9ff, #8c63ff);
    right: 25px;
    bottom: -20px;
}

.design-text {
    position: absolute;
    right: 28px;
    top: 30px;
    font-family: "Space Grotesk", sans-serif;
    font-size: 31px;
    line-height: .82;
    text-align: right;
    z-index: 2;
}

.vision-section {
    padding: 170px 8vw;
    background:
        radial-gradient(circle at 50% 50%, rgba(117, 85, 255, .22), transparent 42%),
        #0c0f24;
    text-align: center;
}

.vision-inner {
    max-width: 900px;
    margin: auto;
}

.vision-section h2,
.contact-section h2 {
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(45px, 7vw, 100px);
    line-height: .9;
    letter-spacing: -5px;
}

.vision-section p:last-child,
.contact-section p:not(.eyebrow) {
    max-width: 560px;
    margin: 35px auto 0;
    color: var(--muted);
    line-height: 1.7;
}

.contact-section {
    padding: 180px 8vw;
    text-align: center;
    background: #080a18;
}

.contact-inner {
    max-width: 1000px;
    margin: auto;
}

.contact-section .button {
    margin-top: 35px;
}

.button-light {
    background: white;
    color: #080a18;
}

.button-light:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(255,255,255,.15);
}

.footer {
    display: flex;
    justify-content: space-between;
    padding: 25px 8vw;
    border-top: 1px solid var(--line);
    color: #777c96;
    font-size: 11px;
}

.footer-links a:hover {
    color: white;
}

.reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity .8s ease, transform .8s ease;
}

.reveal.active {
    opacity: 1;
    transform: translateY(0);
}

.cursor-glow {
    position: fixed;
    width: 260px;
    height: 260px;
    pointer-events: none;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(126, 99, 255, .08), transparent 65%);
    transform: translate(-50%, -50%);
    z-index: 0;
}

@keyframes orbFloat {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-15px) rotate(4deg); }
}

@keyframes orbitSpin {
    from { transform: rotate(-25deg) rotate(0deg); }
    to { transform: rotate(-25deg) rotate(360deg); }
}

@keyframes orbitSpinReverse {
    from { transform: rotate(35deg) rotate(360deg); }
    to { transform: rotate(35deg) rotate(0deg); }
}

@media (max-width: 900px) {
    .hero {
        grid-template-columns: 1fr;
        padding-top: 150px;
    }

    .profile-visual {
        min-height: 500px;
    }

    .about-layout {
        grid-template-columns: 1fr;
        gap: 50px;
    }

    .skills-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .project {
        grid-template-columns: 50px 1fr;
    }

    .project-visual {
        grid-column: 2;
    }
}

@media (max-width: 650px) {
    .navbar {
        padding: 18px 5vw;
    }

    .nav-links,
    .nav-cta {
        display: none;
    }

    .menu-toggle {
        display: block;
    }

    .hero {
        padding: 130px 6vw 80px;
    }

    .hero h1 {
        font-size: 55px;
        letter-spacing: -3px;
    }

    .hero-visual {
        min-height: 360px;
    }

    .profile-frame { width: 280px; height: 390px; min-width: 0; min-height: 0; }

    .floating-label {
        font-size: 9px;
    }

    .section {
        padding: 100px 6vw;
    }

    .section-heading {
        grid-template-columns: 1fr;
        gap: 15px;
        margin-bottom: 50px;
    }

    .section-heading h2 {
        font-size: 48px;
        letter-spacing: -3px;
    }

    .skills-grid {
        grid-template-columns: 1fr;
    }

    .skill {
        min-height: 180px;
    }

    .project {
        grid-template-columns: 1fr;
        gap: 18px;
    }

    .project-number {
        font-size: 18px;
    }

    .project-visual {
        grid-column: 1;
    }

    .vision-section,
    .contact-section {
        padding: 120px 6vw;
    }

    .vision-section h2,
    .contact-section h2 {
        letter-spacing: -3px;
    }

    .footer {
        padding: 25px 6vw;
        flex-direction: column;
        gap: 12px;
    }
}

.contact-actions { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; margin-top: 35px; }
@keyframes profileFloat { 0%,100% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(-12px) rotate(1deg); } }
